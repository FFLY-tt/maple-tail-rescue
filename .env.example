# Copy this file to .env.local and fill in your own values.
# Supabase dashboard > Project Settings > API (or "API Keys").
# Use ONLY the publishable (anon) key. Never put the service_role / secret key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# Public address of the deployed site (share previews, canonical URLs).
NEXT_PUBLIC_SITE_URL=https://www.example.org

# `npm run build` stops if any value above is missing or still a placeholder, because
# they are baked into the site. For a throwaway build with dummy values (CI, tests), run it
# with ALLOW_PLACEHOLDER_ENV=1. Never deploy a build made that way.

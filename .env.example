# Copy this file to .env.local and fill in your own values.
# Supabase dashboard > Project Settings > API (or "API Keys").
# Use ONLY the publishable (anon) key. Never put the service_role / secret key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# Optional: public address of the deployed site (used for share previews).
# NEXT_PUBLIC_SITE_URL=https://www.example.org

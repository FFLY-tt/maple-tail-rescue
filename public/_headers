# Cloudflare Pages headers. This file is copied to the root of the built site (out/).
# Rules that match the same URL are combined.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://formspree.io; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000

# Hashed build files never change, so browsers can keep them for a year.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Not set on purpose: a Content-Type for *.txt. Next.js fetches the __next.*.txt and page .txt files
# to navigate without a reload and expects the default text/plain.
